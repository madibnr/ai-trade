# MT5 Login Credentials
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=Your-Broker-Server

# Trading Settings
SYMBOL=XAUUSD
TIMEFRAME=M1
MAGIC_NUMBER=777777
MAX_OPEN_POSITIONS=1

# Risk Management
RISK_PERCENT=1.0
MAX_SLIPPAGE=30
MAX_LOT=0.05
MAX_SPREAD_POINTS=40
MAX_DAILY_LOSS_PERCENT=2.0
MIN_RR_RATIO=1.5
TARGET_RR_RATIO=2.0

# Proteksi Modal Mikro (Nominal Hard Stop)
MAX_LOSS_IDR=15000.0
KURS_USD_IDR=16000.0

# Auto Break-Even (BEP / Lock Profit)
ENABLE_AUTO_BEP=True
BEP_TRIGGER_PROFIT_IDR=20000.0
BEP_LOCK_OFFSET_PRICE=0.20

# Dynamic Stepped Trade Management (BEP, Stagnant Lock, TP Extender)
ENABLE_DYNAMIC_MANAGEMENT=True
STAGNANT_LOCK_TRIGGER_RATIO=0.70
STAGNANT_TIMEOUT_SECONDS=45.0
STAGNANT_LOCK_PROFIT_RATIO=0.60
ENABLE_TP_EXTENDER=True
TP_EXTENDER_TRIGGER_RATIO=0.85
TP_EXTEND_ATR_MULT=1.0
TP_EXTEND_SL_LOCK_RATIO=0.75

# Daily Target Profit Lock & Circuit Breaker
ENABLE_DAILY_TARGET_LOCK=True
DAILY_TARGET_PROFIT_IDR=500000.0
DAILY_MAX_LOSS_IDR=150000.0

# Operational Mode (INTERACTIVE / AUTO / SIGNAL)
BOT_MODE=INTERACTIVE

# Web Dashboard Configuration (Real-Time Monitoring)
ENABLE_WEB_DASHBOARD=True
WEB_PORT=8080

# AI / LLM Configuration
AI_API_BASE_URL=https://api.example.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL_NAME=ag/gemini-3.8-flash-low
AI_MIN_CONFIDENCE=0.70